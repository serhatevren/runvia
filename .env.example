# Runvia settings. Copy to .env (git-ignored) and fill in the empty secrets.
# Values below are local-development defaults only; never commit real credentials.
# Hostnames assume the API/worker run on the host (make api / make worker);
# Compose services override them with service names (postgres, redis, rabbitmq).

# --- App ---
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
# Tenant apps are served at <app>-<org>.<PLATFORM_DOMAIN>
PLATFORM_DOMAIN=localhost
APP_URL_SCHEME=http
APP_URL_PORT=8080

# --- Data ---
DATABASE_URL=postgresql+psycopg://runvia:runvia@localhost:5432/runvia
REDIS_URL=redis://localhost:6379/0
RABBITMQ_URL=amqp://runvia:runvia@localhost:5672/

# --- Auth ---
# python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=
JWT_ISSUER=runvia
# Seconds: 15 minutes / 30 days
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000
# Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRETS_ENCRYPTION_KEY=

# --- Build / runtime ---
REGISTRY_URL=k3d-runvia-registry.localhost:5000
WORKSPACE_DIR=/tmp/runvia/workspaces
BUILD_TIMEOUT_SECONDS=900
DEPLOY_TIMEOUT_SECONDS=300
INGRESS_CLASS=traefik
# Optional. Inside Kubernetes the in-cluster config is used; otherwise ~/.kube/config
# (where k3d writes its context). Set only to use a different kubeconfig file.
# KUBECONFIG=

# --- Later phases ---
# OBJECT_STORAGE_ENDPOINT=http://localhost:9000
# OBJECT_STORAGE_BUCKET=runvia
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# AWS_REGION=
# SMTP_URL=smtp://localhost:1025
# EMAIL_FROM=Runvia <no-reply@localhost>
